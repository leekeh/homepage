---
/**
 * ArticleList — a dated list of article/news/journal rows, styled after mujuu.jp:
 *
 *   ( LABEL )
 *   Heading
 *   ──────────────────
 *   2026/1/20   Article title goes here
 *   2025/10/31  Another article title
 *   ──────────────────
 *   see more →
 */

type Article = {
  /** Formatted date string, e.g. "2026/1/20" */
  date: string;
  title: string;
  href: string;
};

type Props = {
  /** Section eyebrow label */
  label?: string;
  /** Section heading */
  heading?: string;
  articles: Article[];
  /** "see more" link target */
  seeMoreHref?: string;
  seeMoreText?: string;
};

const {
  label,
  heading,
  articles,
  seeMoreHref,
  seeMoreText = "see more",
} = Astro.props;
---

<section class="article-list">
  <div class="article-list__inner container">
    {label && <p class="section-label">( {label} )</p>}
    {heading && <h2 class="article-list__heading">{heading}</h2>}

    <ul class="article-list__items">
      {
        articles.map((article) => (
          <li class="article-list__item">
            <a href={article.href} class="article-list__link">
              <time class="article-list__date">{article.date}</time>
              <span class="article-list__title">{article.title}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      seeMoreHref && (
        <a class="see-more article-list__more" href={seeMoreHref}>
          {seeMoreText}
          <span class="material-symbols-outlined arrow" aria-hidden="true">
            arrow_forward
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  .article-list {
    padding-block: var(--section-gap);
  }

  .article-list__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: var(--content-width);
  }

  .article-list__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 600;
    color: var(--color-heading);
  }

  /* List */
  .article-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .article-list__item {
    border-bottom: 1px solid var(--color-border);
  }

  .article-list__link {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding-block: 1.25rem;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.2s var(--ease);
  }

  .article-list__link:hover {
    color: var(--color-heading);
  }

  .article-list__date {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .article-list__title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .article-list__more {
    margin-top: 0.5rem;
  }

  @media (max-width: 480px) {
    .article-list__link {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
