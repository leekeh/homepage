---
/**
 * SectionBlock — a full-width page section modelled on mujuu.jp's pattern:
 *   ( LABEL )
 *   Heading text
 *   Body copy
 *   <slot>   ← drop any extra content here
 *   see more →
 */

type Props = {
  /** Section eyebrow label shown as  ( LABEL )  in accent green */
  label?: string;
  /** Main section heading */
  heading?: string;
  /** Optional body paragraph */
  body?: string;
  /** If provided, renders a "see more →" link */
  href?: string;
  /** Text for the "see more" link  (default: "see more") */
  linkText?: string;
  /** Horizontal alignment of text content  (default: "left") */
  align?: "left" | "center";
  /** Use a light-grey background variant */
  tinted?: boolean;
};

const {
  label,
  heading,
  body,
  href,
  linkText = "see more",
  align = "left",
  tinted = false,
} = Astro.props;
---

<section
  class:list={[
    "section-block",
    {
      "section-block--tinted": tinted,
      "section-block--center": align === "center",
    },
  ]}
>
  <div class="section-block__inner container">
    {label && <p class="section-label">( {label} )</p>}

    {heading && <h2 class="section-block__heading">{heading}</h2>}

    {body && <p class="section-block__body">{body}</p>}

    <!-- Additional content injected by the parent -->
    <slot />

    {
      href && (
        <a class="see-more section-block__link" href={href}>
          {linkText}
          <span class="material-symbols-outlined arrow" aria-hidden="true">
            arrow_forward
          </span>
        </a>
      )
    }
  </div>
</section>

<style>
  .section-block {
    padding-block: var(--section-gap);
  }

  .section-block--tinted {
    background-color: #f7f7f5;
  }

  .section-block__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: var(--content-width);
  }

  .section-block--center .section-block__inner {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .section-block__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--color-heading);
    line-height: 1.35;
  }

  .section-block__body {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 2.6;
    color: var(--color-text);
    max-width: 52ch;
  }

  .section-block--center .section-block__body {
    max-width: 44ch;
  }

  .section-block__link {
    margin-top: 0.5rem;
  }
</style>
