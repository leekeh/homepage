---
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

type Props = {
  title: string;
  description: string;
  /** When true the main element has no padding — useful for full-bleed hero pages */
  fullBleed?: boolean;
};

const { title, description, fullBleed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main class={fullBleed ? "" : "main-content"}>
      <slot />
      <script
        type="module"
        src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.2.0/model-viewer.min.js"
      ></script>
      <model-viewer
        oncontextmenu="return false;"
        id="mainModel"
        environment-image="https://static.poly.pizza/hdr/BG.hdr"
        class="w-full h-full"
        src="https://static.poly.pizza/68748185-11a5-4ea3-97a5-85833aa972fa.glb"
        alt="Computer 90s"
        auto-rotate="true"
        camera-controls="true"
        shadow-intensity="1"
        interaction-prompt="auto"
        loading="eager"
        camera-orbit="0.74719rad 1.40409rad 0.20148890491828925m"
        style="--poster-color: #303030;"
        field-of-view="42deg"
        max-field-of-view="42deg"
        data-js-focus-visible=""
        ar-status="not-presenting"
        animation-name="undefined"></model-viewer>
      Lorem, ipsum dolor sit amet consectetur adipisicing elit. Quo architecto reiciendis
      consequuntur eveniet, illo dolorum, non, inventore sunt eaque magnam aliquam?
      Blanditiis veritatis minima, natus illum unde ea sapiente officiis, omnis ducimus,
      voluptatem dolorem? Minus, nisi alias hic possimus eos odio, adipisci repellendus
      dolorem facere porro, deleniti quae quam earum. Nam, labore. Nisi minima deserunt
      aut excepturi explicabo, maiores dolor esse recusandae sapiente rerum inventore,
      corrupti itaque soluta. Similique quae odit culpa id! Voluptate magnam cumque
      sunt quos ullam esse distinctio sed deserunt quam laboriosam culpa assumenda
      dolor rem, eum debitis ex doloremque temporibus natus illum fuga quidem eaque
      exercitationem.
    </main>
  </body>
</html>

<style>
  body {
    border: 3px solid #006d36;
    border-radius: 8px;
    max-width: 700px;
    margin: 2rem;
    margin-inline: auto;
    height: 100%;
  }

  main {
    padding: 2rem;
  }
</style>
