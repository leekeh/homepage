{
	"name": "homepage",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"knip": "knip",
		"standard:publish": "node scripts/publish-standard-site.mjs",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:unit:changed": "vitest run --changed origin/main",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:a11y": "playwright test axe",
		"test:html": "html-validate \".svelte-kit/cloudflare/**/*.html\"",
		"test:lighthouse": "lhci autorun",
		"optimize:images": "node scripts/optimize-images.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "^0.15.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.4",
		"@types/unist": "^3.0.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"html-validate": "^11.16.2",
		"knip": "^6.40.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vfile": "^6.0.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.148.0"
	},
	"dependencies": {
		"@google/model-viewer": "^4.3.1",
		"@xeonlink/prettier-plugin-organize-attributes": "^1.1.0",
		"gray-matter": "^4.0.3",
		"shiki": "^4.5.0",
		"unist-util-visit": "^5.1.0"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.35.5"
		}
	}
}
