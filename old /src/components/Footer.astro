---
import { SITE_TITLE } from "../consts";
const today = new Date();

const navGroups = [
  {
    title: "Navigation",
    links: [
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: "About", href: "/about" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top: logo + nav columns -->
    <div class="footer-top">
      <a href="/" class="footer-logo">{SITE_TITLE}</a>

      <div class="footer-nav">
        {
          navGroups.map((group) => (
            <div class="footer-nav-group">
              <span class="footer-nav-title">{group.title}</span>
              <ul>
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>
                      <span
                        class="material-symbols-outlined"
                        aria-hidden="true"
                      >
                        arrow_forward
                      </span>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <hr class="footer-divider" />

    <!-- Bottom: copyright -->
    <div class="footer-bottom">
      <span class="footer-copy">&copy; {today.getFullYear()} {SITE_TITLE}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-footer-bg);
    color: var(--color-footer-text);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding: 5rem var(--gutter) 3rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  .footer-logo {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .footer-nav {
    display: flex;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .footer-nav-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-nav-title {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .footer-nav-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-nav-group a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-footer-text);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .footer-nav-group a:hover {
    color: #fff;
  }

  .footer-nav-group .material-symbols-outlined {
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .footer-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin: 0;
  }

  .footer-bottom {
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      gap: 2.5rem;
    }

    .footer-nav {
      gap: 2.5rem;
    }
  }
</style>
